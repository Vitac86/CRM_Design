# Скопируйте в .env.qort.local. Имя узла и экземпляра указывается только в локальной копии.
QORT_SERVER=
QORT_DATABASE=BACK_QORT_DB
QORT_TRUSTED_CONNECTION=true
# HTTP-порт мастера. Порт SQL при необходимости указывается как SERVER,1433.
QORT_PORT=4179
QORT_QUERY_TIMEOUT_MS=10000
# Для сервера с сертификатом внутреннего УЦ установите корневой сертификат в Windows.
QORT_TRUST_SERVER_CERTIFICATE=false
